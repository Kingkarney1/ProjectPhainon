%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 082b860275b03d2079186b1a9865292c, type: 3}
  m_Name: GroundControlScript
  m_EditorClassIdentifier: Phainon.Runtime::Phainon.GroundControlScript
  spec:
    replyWindowSeconds: 40
    staleAfterSeconds: 90
    groundReactsAfterLightTime: 0
    timeAccelerationWhileAwaiting: 0
    characters:
    - id: flight
      name: Mara Okafor
      role: FLIGHT DIRECTOR
    - id: capcom
      name: Dev Anand
      role: CAPCOM
    - id: guidance
      name: Ilse Brandt
      role: GUIDANCE
    - id: propulsion
      name: Tomas Reyes
      role: PROPULSION
    - id: surgeon
      name: Dr. Hana Sato
      role: FLIGHT SURGEON
    lines:
    - id: comm_check
      speaker: capcom
      trigger: 1
      warning: 0
      fault: 0
      delaySeconds: 1.5
      requiresFlag: 
      forbidsFlag: 
      text: Phainon, this is Meridian Control. Comm check. How do you read?
      replies:
      - label: Loud and clear
        line: Meridian, Phainon. Reading you loud and clear.
        setsFlag: crew_talkative
        followUp: comm_check_ack
      - label: Ask for a status
        line: Meridian, Phainon. Reading you fine. What is the status on your side?
        setsFlag: asked_status
        followUp: comm_check_status
      storyEvent: 
      logged: 0
      garbled: 0
      requestLabel: 
      requestLine: 
      setsFlag: 
      alreadyOnItsWay: 0
    - id: comm_check_ack
      speaker: capcom
      trigger: 0
      warning: 0
      fault: 0
      delaySeconds: 1
      requiresFlag: 
      forbidsFlag: 
      text: Copy, Phainon. Good signal here too. We are with you all the way up.
      replies: []
      storyEvent: 
      logged: 0
      garbled: 0
      requestLabel: 
      requestLine: 
      setsFlag: 
      alreadyOnItsWay: 0
    - id: comm_check_status
      speaker: flight
      trigger: 0
      warning: 0
      fault: 0
      delaySeconds: 1.5
      requiresFlag: 
      forbidsFlag: 
      text: Phainon, Flight. The range is clear and the team is at their consoles. We are waiting on your board.
      replies: []
      storyEvent: 
      logged: 0
      garbled: 0
      requestLabel: 
      requestLine: 
      setsFlag: 
      alreadyOnItsWay: 0
    - id: comm_check_silent
      speaker: capcom
      trigger: 18
      warning: 0
      fault: 0
      delaySeconds: 1
      requiresFlag: comm_check_no_reply
      forbidsFlag: 
      text: Phainon, Meridian. No copy on your last. We will keep the channel open.
      replies: []
      storyEvent: 
      logged: 0
      garbled: 0
      requestLabel: 
      requestLine: 
      setsFlag: 
      alreadyOnItsWay: 0
    - id: nav_aligned
      speaker: guidance
      trigger: 3
      warning: 0
      fault: 0
      delaySeconds: 1
      requiresFlag: 
      forbidsFlag: '@guidance_active'
      text: Phainon, Guidance. We see your platform aligned. NAV MODE to ASCENT and GUIDANCE on when you are ready.
      replies: []
      storyEvent: 
      logged: 0
      garbled: 0
      requestLabel: 
      requestLine: 
      setsFlag: 
      alreadyOnItsWay: 0
    - id: go_poll
      speaker: flight
      trigger: 4
      warning: 0
      fault: 0
      delaySeconds: 1
      requiresFlag: 
      forbidsFlag: '@counting'
      text: Phainon, Flight. I have polled the room and every station is go. Your board is green. Start the launch sequence when you are ready.
      replies: []
      storyEvent: 
      logged: 0
      garbled: 0
      requestLabel: 
      requestLine: 
      setsFlag: 
      alreadyOnItsWay: 0
    - id: count_started
      speaker: capcom
      trigger: 5
      warning: 0
      fault: 0
      delaySeconds: 0.5
      requiresFlag: 
      forbidsFlag: '@lifted_off'
      text: The clock is running. Throttle to full, and ignite in the window at T minus {window}.
      replies: []
      storyEvent: 
      logged: 0
      garbled: 0
      requestLabel: 
      requestLine: 
      setsFlag: 
      alreadyOnItsWay: 0
    - id: count_hold
      speaker: flight
      trigger: 6
      warning: 0
      fault: 0
      delaySeconds: 0.5
      requiresFlag: 
      forbidsFlag: 
      text: Phainon, Flight. We see the hold. Clear the no-go item on your board and the count will pick up.
      replies: []
      storyEvent: 
      logged: 0
      garbled: 0
      requestLabel: 
      requestLine: 
      setsFlag: 
      alreadyOnItsWay: 0
    - id: ignition
      speaker: propulsion
      trigger: 7
      warning: 0
      fault: 0
      delaySeconds: 0.5
      requiresFlag: 
      forbidsFlag: 
      text: Propulsion sees ignition. Chamber pressure is coming up.
      replies: []
      storyEvent: 
      logged: 0
      garbled: 0
      requestLabel: 
      requestLine: 
      setsFlag: 
      alreadyOnItsWay: 0
    - id: liftoff
      speaker: capcom
      trigger: 8
      warning: 0
      fault: 0
      delaySeconds: 1
      requiresFlag: 
      forbidsFlag: 
      text: Liftoff. Phainon has cleared the tower. Good luck.
      replies: []
      storyEvent: 
      logged: 0
      garbled: 0
      requestLabel: 
      requestLine: 
      setsFlag: 
      alreadyOnItsWay: 0
    - id: max_q
      speaker: guidance
      trigger: 9
      warning: 0
      fault: 0
      delaySeconds: 1
      requiresFlag: 
      forbidsFlag: 
      text: Phainon, you are through max-Q at {alt} kilometres. Throttle up when you are ready.
      replies: []
      storyEvent: 
      logged: 0
      garbled: 0
      requestLabel: 
      requestLine: 
      setsFlag: 
      alreadyOnItsWay: 0
    - id: booster_cutoff
      speaker: capcom
      trigger: 10
      warning: 0
      fault: 0
      delaySeconds: 0.5
      requiresFlag: 
      forbidsFlag: '@upper_stage'
      text: Booster cutoff confirmed. Lift the guard and separate the stage.
      replies: []
      storyEvent: 
      logged: 0
      garbled: 0
      requestLabel: 
      requestLine: 
      setsFlag: 
      alreadyOnItsWay: 0
    - id: separation
      speaker: guidance
      trigger: 11
      warning: 0
      fault: 0
      delaySeconds: 0.5
      requiresFlag: 
      forbidsFlag: '@burning'
      text: Clean separation at {alt} kilometres. Light the upper stage.
      replies: []
      storyEvent: 
      logged: 0
      garbled: 0
      requestLabel: 
      requestLine: 
      setsFlag: 
      alreadyOnItsWay: 0
    - id: upper_ignition
      speaker: propulsion
      trigger: 12
      warning: 0
      fault: 0
      delaySeconds: 1
      requiresFlag: 
      forbidsFlag: '@in_orbit'
      text: Upper stage is burning with good chamber pressure. Hold the burn until Guidance calls orbit.
      replies: []
      storyEvent: 
      logged: 0
      garbled: 0
      requestLabel: 
      requestLine: 
      setsFlag: 
      alreadyOnItsWay: 0
    - id: orbit_go
      speaker: guidance
      trigger: 13
      warning: 0
      fault: 0
      delaySeconds: 0.5
      requiresFlag: 
      forbidsFlag: '@in_orbit'
      text: Phainon, Guidance. Periapsis is above the atmosphere. You are go for cutoff.
      replies: []
      storyEvent: 
      logged: 0
      garbled: 0
      requestLabel: 
      requestLine: 
      setsFlag: 
      alreadyOnItsWay: 0
    - id: warn_max_q
      speaker: propulsion
      trigger: 16
      warning: 4
      fault: 0
      delaySeconds: 0.5
      requiresFlag: 
      forbidsFlag: 
      text: Phainon, Propulsion. Dynamic pressure is over the limit. Ease the throttle back until the warning clears.
      replies: []
      storyEvent: 
      logged: 0
      garbled: 0
      requestLabel: 
      requestLine: 
      setsFlag: 
      alreadyOnItsWay: 0
    - id: warn_g
      speaker: surgeon
      trigger: 16
      warning: 5
      fault: 0
      delaySeconds: 0.5
      requiresFlag: 
      forbidsFlag: 
      text: Phainon, Surgeon. The G load is over the limit for the crew. Bring the throttle down, please.
      replies: []
      storyEvent: 
      logged: 0
      garbled: 0
      requestLabel: 
      requestLine: 
      setsFlag: 
      alreadyOnItsWay: 0
    - id: warn_fuel
      speaker: propulsion
      trigger: 16
      warning: 3
      fault: 0
      delaySeconds: 0.5
      requiresFlag: '@upper_stage'
      forbidsFlag: '@in_orbit'
      text: 'Phainon, Propulsion. Upper stage is at {fuel} percent. Keep the burn going: you need all of it for orbit.'
      replies: []
      storyEvent: 
      logged: 0
      garbled: 0
      requestLabel: 
      requestLine: 
      setsFlag: 
      alreadyOnItsWay: 0
    - id: warn_apu
      speaker: propulsion
      trigger: 16
      warning: 2
      fault: 0
      delaySeconds: 0.5
      requiresFlag: 
      forbidsFlag: 
      text: 'Phainon, Propulsion. The APU is offline. You are on batteries and you have lost engine gimbal. Cycle the APU switch: off, then on.'
      replies: []
      storyEvent: 
      logged: 0
      garbled: 0
      requestLabel: 
      requestLine: 
      setsFlag: 
      alreadyOnItsWay: 0
    - id: warn_flameout
      speaker: propulsion
      trigger: 16
      warning: 11
      fault: 0
      delaySeconds: 0.5
      requiresFlag: 
      forbidsFlag: 
      text: Phainon, Propulsion. We saw the engine flame out on feed pressure. Check FUEL PUMP and TANK PRESS, then relight.
      replies: []
      storyEvent: 
      logged: 0
      garbled: 0
      requestLabel: 
      requestLine: 
      setsFlag: 
      alreadyOnItsWay: 0
    - id: warn_sink
      speaker: guidance
      trigger: 16
      warning: 13
      fault: 0
      delaySeconds: 0.5
      requiresFlag: 
      forbidsFlag: 
      text: Phainon, Guidance. You are sinking at {alt} kilometres. Pitch up and add thrust now.
      replies: []
      storyEvent: 
      logged: 0
      garbled: 0
      requestLabel: 
      requestLine: 
      setsFlag: 
      alreadyOnItsWay: 0
    - id: warn_cabin
      speaker: surgeon
      trigger: 16
      warning: 6
      fault: 0
      delaySeconds: 0.5
      requiresFlag: 
      forbidsFlag: 
      text: Phainon, Surgeon. Cabin pressure is dropping. Check that CABIN SYS is on.
      replies: []
      storyEvent: 
      logged: 0
      garbled: 0
      requestLabel: 
      requestLine: 
      setsFlag: 
      alreadyOnItsWay: 0
    - id: fault_pump
      speaker: propulsion
      trigger: 19
      warning: 0
      fault: 1
      delaySeconds: 3
      requiresFlag: 
      forbidsFlag: 
      text: Phainon, Propulsion. Feed pressure is sagging on a pump fault. Cycle FUEL PUMP, off and straight back on, before the engine starves.
      replies: []
      storyEvent: 
      logged: 0
      garbled: 0
      requestLabel: 
      requestLine: 
      setsFlag: 
      alreadyOnItsWay: 0
    - id: fault_battery
      speaker: capcom
      trigger: 19
      warning: 0
      fault: 2
      delaySeconds: 3
      requiresFlag: 
      forbidsFlag: 
      text: 'Phainon, Meridian. Battery A has shorted and it is dragging the bus down. Isolate it: BATT A off. You are fine on B and the APU.'
      replies: []
      storyEvent: 
      logged: 0
      garbled: 0
      requestLabel: 
      requestLine: 
      setsFlag: 
      alreadyOnItsWay: 0
    - id: fault_nav
      speaker: guidance
      trigger: 19
      warning: 0
      fault: 3
      delaySeconds: 3
      requiresFlag: 
      forbidsFlag: 
      text: Phainon, Guidance. Your platform has dropped out and guidance is not steering. Press NAV SYSTEM to realign, and hold attitude by hand until it is back.
      replies: []
      storyEvent: 
      logged: 0
      garbled: 0
      requestLabel: 
      requestLine: 
      setsFlag: 
      alreadyOnItsWay: 0
    - id: fault_engine
      speaker: propulsion
      trigger: 19
      warning: 0
      fault: 5
      delaySeconds: 4
      requiresFlag: 
      forbidsFlag: 
      text: Phainon, Propulsion. The engine is only making {thrust} percent. There is nothing to fix from the seat. Keep the throttle up; the burn will run long.
      replies: []
      storyEvent: 
      logged: 0
      garbled: 0
      requestLabel: 
      requestLine: 
      setsFlag: 
      alreadyOnItsWay: 0
    - id: cleared_apu
      speaker: propulsion
      trigger: 20
      warning: 0
      fault: 0
      delaySeconds: 1.5
      requiresFlag: 
      forbidsFlag: 
      text: APU is back on the bus and you have gimbal again. Nicely done.
      replies: []
      storyEvent: 
      logged: 0
      garbled: 0
      requestLabel: 
      requestLine: 
      setsFlag: 
      alreadyOnItsWay: 0
    - id: cleared_pump
      speaker: propulsion
      trigger: 20
      warning: 0
      fault: 1
      delaySeconds: 1.5
      requiresFlag: 
      forbidsFlag: 
      text: Feed pressure is back in the green. Good catch, Phainon.
      replies: []
      storyEvent: 
      logged: 0
      garbled: 0
      requestLabel: 
      requestLine: 
      setsFlag: 
      alreadyOnItsWay: 0
    - id: cleared_battery
      speaker: capcom
      trigger: 20
      warning: 0
      fault: 2
      delaySeconds: 1.5
      requiresFlag: 
      forbidsFlag: 
      text: We see battery A off the bus and the load back to normal. Leave it isolated.
      replies: []
      storyEvent: 
      logged: 0
      garbled: 0
      requestLabel: 
      requestLine: 
      setsFlag: 
      alreadyOnItsWay: 0
    - id: cleared_nav
      speaker: guidance
      trigger: 20
      warning: 0
      fault: 3
      delaySeconds: 1.5
      requiresFlag: 
      forbidsFlag: 
      text: Platform is realigned and guidance has the vehicle again.
      replies: []
      storyEvent: 
      logged: 0
      garbled: 0
      requestLabel: 
      requestLine: 
      setsFlag: 
      alreadyOnItsWay: 0
    - id: cleared_antenna
      speaker: capcom
      trigger: 20
      warning: 0
      fault: 4
      delaySeconds: 4
      requiresFlag: 
      forbidsFlag: 
      text: That was your transmitter, not us. Good recovery.
      replies: []
      storyEvent: 
      logged: 0
      garbled: 0
      requestLabel: 
      requestLine: 
      setsFlag: 
      alreadyOnItsWay: 0
    - id: link_restored
      speaker: capcom
      trigger: 2
      warning: 0
      fault: 0
      delaySeconds: 1
      requiresFlag: 
      forbidsFlag: 
      text: Phainon, Meridian. We have you back. You dropped off our screens for a while.
      replies: []
      storyEvent: 
      logged: 0
      garbled: 0
      requestLabel: 
      requestLine: 
      setsFlag: 
      alreadyOnItsWay: 0
    - id: mission_failed
      speaker: flight
      trigger: 15
      warning: 0
      fault: 0
      delaySeconds: 2
      requiresFlag: 
      forbidsFlag: 
      text: Phainon, Flight. We have lost the mission. Safe the vehicle. We will go through the data together.
      replies: []
      storyEvent: 
      logged: 0
      garbled: 0
      requestLabel: 
      requestLine: 
      setsFlag: 
      alreadyOnItsWay: 0
    - id: orbit
      speaker: flight
      trigger: 14
      warning: 0
      fault: 0
      delaySeconds: 2
      requiresFlag: crew_talkative
      forbidsFlag: 
      text: 'Phainon, Flight. Welcome to orbit: {peri} by {apo} kilometres. You were loud and clear on the pad and you flew it the same way. Outstanding.'
      replies: []
      storyEvent: 
      logged: 0
      garbled: 0
      requestLabel: 
      requestLine: 
      setsFlag: 
      alreadyOnItsWay: 0
    - id: orbit
      speaker: flight
      trigger: 14
      warning: 0
      fault: 0
      delaySeconds: 2
      requiresFlag: 
      forbidsFlag: crew_talkative
      text: Phainon, Flight. Orbit confirmed at {peri} by {apo} kilometres. Well flown.
      replies: []
      storyEvent: 
      logged: 0
      garbled: 0
      requestLabel: 
      requestLine: 
      setsFlag: 
      alreadyOnItsWay: 0
    - id: crew_check
      speaker: surgeon
      trigger: 17
      warning: 0
      fault: 0
      delaySeconds: 12
      requiresFlag: 
      forbidsFlag: 
      text: Phainon, Surgeon. That was a hard ride. How is the crew feeling?
      replies:
      - label: All well
        line: Surgeon, Phainon. All well up here. The view is something else.
        setsFlag: crew_well
        followUp: crew_check_well
      - label: A little shaken
        line: Surgeon, Phainon. A little shaken, but we are fine.
        setsFlag: crew_shaken
        followUp: crew_check_shaken
      storyEvent: 
      logged: 0
      garbled: 0
      requestLabel: 
      requestLine: 
      setsFlag: 
      alreadyOnItsWay: 0
    - id: crew_check_well
      speaker: surgeon
      trigger: 0
      warning: 0
      fault: 0
      delaySeconds: 1.5
      requiresFlag: 
      forbidsFlag: 
      text: Copy. Your vitals agree with you. Enjoy it.
      replies: []
      storyEvent: 
      logged: 0
      garbled: 0
      requestLabel: 
      requestLine: 
      setsFlag: 
      alreadyOnItsWay: 0
    - id: crew_check_shaken
      speaker: surgeon
      trigger: 0
      warning: 0
      fault: 0
      delaySeconds: 1.5
      requiresFlag: 
      forbidsFlag: 
      text: Understood. Take ten minutes before any more work. Flight has agreed to hold the timeline.
      replies: []
      storyEvent: 
      logged: 0
      garbled: 0
      requestLabel: 
      requestLine: 
      setsFlag: 
      alreadyOnItsWay: 0
    - id: extend
      speaker: flight
      trigger: 17
      warning: 0
      fault: 0
      delaySeconds: 40
      requiresFlag: 
      forbidsFlag: '@escaped'
      text: Phainon, Flight. Your service module is full and the trajectory team has a way out of Earth orbit for you. Do you want to take her out, or shall we call it a day?
      replies:
      - label: Go for departure
        line: Flight, Phainon. We would like to take her out.
        setsFlag: extend_mission
        followUp: extend_yes
      - label: Stand down
        line: Flight, Phainon. We are happy to call it there.
        setsFlag: stand_down
        followUp: extend_no
      storyEvent: 
      logged: 0
      garbled: 0
      requestLabel: 
      requestLine: 
      setsFlag: 
      alreadyOnItsWay: 0
    - id: extend_yes
      speaker: guidance
      trigger: 0
      warning: 0
      fault: 0
      delaySeconds: 1.5
      requiresFlag: 
      forbidsFlag: 
      text: Copy, go for departure. Drop the upper stage. NAV MODE to ORBIT with GUIDANCE and RCS on, then light the service module and hold the burn until apoapsis reads ESCAPE.
      replies: []
      storyEvent: 
      logged: 0
      garbled: 0
      requestLabel: 
      requestLine: 
      setsFlag: 
      alreadyOnItsWay: 0
    - id: extend_no
      speaker: flight
      trigger: 0
      warning: 0
      fault: 0
      delaySeconds: 1.5
      requiresFlag: crew_shaken
      forbidsFlag: 
      text: Agreed, and the Surgeon will be glad to hear it. Good work today, Phainon. The service module stays fuelled if you change your mind.
      replies: []
      storyEvent: 
      logged: 0
      garbled: 0
      requestLabel: 
      requestLine: 
      setsFlag: 
      alreadyOnItsWay: 0
    - id: extend_no
      speaker: flight
      trigger: 0
      warning: 0
      fault: 0
      delaySeconds: 1.5
      requiresFlag: 
      forbidsFlag: crew_shaken
      text: Copy, standing down. Good work today, Phainon. The service module stays fuelled if you change your mind.
      replies: []
      storyEvent: 
      logged: 0
      garbled: 0
      requestLabel: 
      requestLine: 
      setsFlag: 
      alreadyOnItsWay: 0
    - id: jettison
      speaker: propulsion
      trigger: 21
      warning: 0
      fault: 0
      delaySeconds: 1.5
      requiresFlag: 
      forbidsFlag: 
      text: Upper stage is away and clear. Service module shows {fuel} percent and a good feed.
      replies: []
      storyEvent: 
      logged: 0
      garbled: 0
      requestLabel: 
      requestLine: 
      setsFlag: 
      alreadyOnItsWay: 0
    - id: departure_burn
      speaker: guidance
      trigger: 22
      warning: 0
      fault: 0
      delaySeconds: 3
      requiresFlag: 
      forbidsFlag: '@escaped'
      text: Good burn, Phainon. The far side of your orbit is climbing. Hold it until apoapsis reads ESCAPE.
      replies: []
      storyEvent: 
      logged: 0
      garbled: 0
      requestLabel: 
      requestLine: 
      setsFlag: 
      alreadyOnItsWay: 0
    - id: escape
      speaker: flight
      trigger: 23
      warning: 0
      fault: 0
      delaySeconds: 2
      requiresFlag: extend_mission
      forbidsFlag: 
      text: Phainon, Flight. You are on an escape trajectory at {vel} metres per second. You are no longer in orbit around the Earth. This is what we came for.
      replies: []
      storyEvent: 
      logged: 0
      garbled: 0
      requestLabel: 
      requestLine: 
      setsFlag: 
      alreadyOnItsWay: 0
    - id: escape
      speaker: flight
      trigger: 23
      warning: 0
      fault: 0
      delaySeconds: 2
      requiresFlag: 
      forbidsFlag: extend_mission
      text: Phainon, Flight. We show you on an escape trajectory at {vel} metres per second. That was not in today's plan, but we are with you. Cut the engine when you are happy.
      replies: []
      storyEvent: 
      logged: 0
      garbled: 0
      requestLabel: 
      requestLine: 
      setsFlag: 
      alreadyOnItsWay: 0
    - id: dist_10k
      speaker: capcom
      trigger: 24
      warning: 0
      fault: 0
      delaySeconds: 1
      requiresFlag: '@km:10000'
      forbidsFlag: 
      text: Phainon, Meridian. {dist} kilometres out. The whole Earth should fit in your window now.
      replies: []
      storyEvent: 
      logged: 0
      garbled: 0
      requestLabel: 
      requestLine: 
      setsFlag: 
      alreadyOnItsWay: 0
    - id: dist_100k
      speaker: guidance
      trigger: 24
      warning: 0
      fault: 0
      delaySeconds: 1
      requiresFlag: '@km:100000'
      forbidsFlag: 
      text: Phainon, Guidance. {dist} kilometres. Your signal now takes {delay} seconds to reach us, so expect a pause before we answer.
      replies: []
      storyEvent: 
      logged: 0
      garbled: 0
      requestLabel: 
      requestLine: 
      setsFlag: 
      alreadyOnItsWay: 0
    - id: coast_check
      speaker: surgeon
      trigger: 24
      warning: 0
      fault: 0
      delaySeconds: 20
      requiresFlag: '@km:100000'
      forbidsFlag: 
      text: Phainon, Surgeon. It gets quiet out there. How are you holding up?
      replies:
      - label: Enjoying the quiet
        line: Surgeon, Phainon. Enjoying the quiet. It is a long way to look back.
        setsFlag: coast_content
        followUp: coast_check_content
      - label: Missing home
        line: Surgeon, Phainon. Honestly, missing home a little.
        setsFlag: coast_homesick
        followUp: coast_check_homesick
      storyEvent: 
      logged: 0
      garbled: 0
      requestLabel: 
      requestLine: 
      setsFlag: 
      alreadyOnItsWay: 0
    - id: coast_check_content
      speaker: surgeon
      trigger: 0
      warning: 0
      fault: 0
      delaySeconds: 1.5
      requiresFlag: 
      forbidsFlag: 
      text: Good. Sleep when you can. We will keep the calls short.
      replies: []
      storyEvent: 
      logged: 0
      garbled: 0
      requestLabel: 
      requestLine: 
      setsFlag: 
      alreadyOnItsWay: 0
    - id: coast_check_homesick
      speaker: surgeon
      trigger: 0
      warning: 0
      fault: 0
      delaySeconds: 1.5
      requiresFlag: 
      forbidsFlag: 
      text: That is the healthy answer. Home can still hear you, and we are not going anywhere.
      replies: []
      storyEvent: 
      logged: 0
      garbled: 0
      requestLabel: 
      requestLine: 
      setsFlag: 
      alreadyOnItsWay: 0
    - id: dist_moon
      speaker: flight
      trigger: 24
      warning: 0
      fault: 0
      delaySeconds: 1
